# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
DATABASE_URL=sqlite:///instance/skyguard.db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Security Settings
MAX_CONTENT_LENGTH=5242880  # 5 MB maximum file upload
RATELIMIT_DEFAULT=60 per minute

# Email / SMTP Configuration (Optional - logs to console if unconfigured)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@skyguard.ai
MAIL_RESET_TOKEN_EXPIRATION_SECONDS=3600

